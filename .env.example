# Cliente OAuth de Google (tipo "Aplicación web") para respaldar en Google Drive.
# Orígenes autorizados: http://localhost:5173, http://localhost:4173 y el dominio de producción.
VITE_GOOGLE_CLIENT_ID=

# Carpeta de Google Drive predeterminada para los respaldos (se puede cambiar en la app).
VITE_DRIVE_FOLDER_URL=
